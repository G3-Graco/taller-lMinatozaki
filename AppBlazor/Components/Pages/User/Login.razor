@page "/auth/login"
@using Core.Entities
@using AppBlazor.Data.Auth
@using AppBlazor.Data.Models
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Authorization
@using AppBlazor.Data.Services
@using AppBlazor.Data.Auth
@inject AuthService AuthService
@inject TokenContainer TokenContainer
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavManager

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <h3 class="text-center mb-4">Iniciar Sesión</h3>
            
            <EditForm Model="@model" OnValidSubmit="HandleLogin" FormName="loginForm">
                @* <DataAnnotationsValidator /> *@
                
                <div class="mb-3">
                    <label class="form-label">Usuario</label>
                    <InputText @bind-Value="model.UserName" class="form-control" />
                    @* <ValidationMessage For="() => model.UserName" /> *@
                </div>

                <div class="mb-3">
                    <label class="form-label">Contraseña</label>
                    <InputText @bind-Value="model.Password" class="form-control" />
                    @* <ValidationMessage For="() => model.Password" /> *@
                </div>

                <button type="submit" class="btn btn-primary w-100">Ingresar</button>
            </EditForm>

            <div class="mt-3 text-center">
                ¿No tienes cuenta? <a href="/auth/register">Regístrate aquí</a>
            </div>
        </div>
    </div>
</div>

@code {
    private UserDTO model = new UserDTO();

    private async void HandleLogin()
    {
        try
        {
            Console.WriteLine($"Usuario: {model.UserName}, Contraseña: {model.Password}");
            var response = await AuthService.Login(model);
            
            if (response != null && response.Ok)
            {
                ((CustomAuthenticationStateProvider)AuthStateProvider).NotifyAuthStateChanged();
                NavManager.NavigateTo("/");
            }
            else
            {
                Console.WriteLine($"Error: {response.Message}");
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Excepción: {ex.Message}");
        }
    }
}